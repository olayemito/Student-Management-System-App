# App environment (Vite exposes VITE_* vars to the client bundle).
# The Supabase anon key is safe to expose in the frontend bundle (§9).
# RLS is the real security boundary, not key secrecy.

# Supabase project (dev for now; will be swapped for prod at Phase 5)
VITE_SUPABASE_URL=https://mwmghlvnxfrpbckprmnq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_akdwb6NeQs85G0UVUwAcKA_gXtU9wVi

# Public site URL — used for Supabase password-reset redirect target.
# Set this to the deployed Cloudflare Pages URL in production.
# Leave empty / unset to fall back to window.location.origin (handy for local dev).
VITE_PUBLIC_SITE_URL=
